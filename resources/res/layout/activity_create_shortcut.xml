<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/create_shortcut_title"
            app:titleTextColor="@color/text_primary"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_title"/>
                <ImageView
                    android:id="@+id/imgPreviewIcon"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Shortcut Preview Icon"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/txtPreviewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="My Folder"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/step_1_folder"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/txtSelectedFolderPath"
                    android:background="@color/surface_variant"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select a folder using System Picker..."/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="@color/primary"
                    android:id="@+id/btnSafPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select Folder via System Storage"
                    app:strokeColor="@color/primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/step_2_name"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/text_primary"
                    android:id="@+id/editShortcutLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Shortcut Name"
                    android:inputType="textCapWords"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/step_3_icon"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleIconType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypePreset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_type_preset"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypePersonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_type_personal"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/layoutPersonalImage"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_select_image"
                        app:backgroundTint="@color/secondary"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/shape_mask"/>
                    <HorizontalScrollView
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupShapes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true"
                            app:singleSelection="true">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shape_circle"
                                style="@style/Widget.MaterialComponents.Chip.Choice"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipRounded"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shape_rounded"
                                style="@style/Widget.MaterialComponents.Chip.Choice"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSquircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shape_squircle"
                                style="@style/Widget.MaterialComponents.Chip.Choice"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHexagon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shape_hexagon"
                                style="@style/Widget.MaterialComponents.Chip.Choice"/>
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipStar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shape_star"
                                style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutPresetSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPresetIcons"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/background_color"/>
                    <HorizontalScrollView
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/layoutColorPalette"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:layout_gravity="bottom"
        android:id="@+id/btnPinShortcut"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/btn_add_to_home"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_shortcut"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
